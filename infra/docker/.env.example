# Yaya Platform Environment
# Copy to .env and customize — or run infra/scripts/setup.sh to auto-generate
#
# IMPORTANT: All password/secret fields are REQUIRED in production.
# Generate secure values with: openssl rand -hex 24

# ── Host ──
HOST_IP=localhost

# ── Main Database (PostgreSQL) ──
POSTGRES_USER=yaya
POSTGRES_PASSWORD=         # REQUIRED: generate with `openssl rand -hex 24`
POSTGRES_DB=yaya

# ── Service Database Passwords ──
LAGO_DB_USER=lago
LAGO_DB_PASSWORD=          # REQUIRED: generate with `openssl rand -hex 24`
LAGO_DB_NAME=lago_db
CRM_DB_PASSWORD=           # REQUIRED: generate with `openssl rand -hex 24`
METABASE_DB_PASSWORD=      # REQUIRED: generate with `openssl rand -hex 24`
CALCOM_DB_PASSWORD=        # REQUIRED: generate with `openssl rand -hex 24`

# ── Redis ──
REDIS_PASSWORD=            # REQUIRED: generate with `openssl rand -hex 24`

# ── Object Storage (MinIO) ──
MINIO_ROOT_USER=yaya_s3
MINIO_ROOT_PASSWORD=       # REQUIRED: generate with `openssl rand -hex 24`

# ── LLM (vLLM + Qwen3.5-27B) ──
MODEL_PATH=/home/yaya/models/Qwen3.5-27B-AWQ
LLM_API_KEY=

# ── Whisper ──
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=es

# ── Kokoro TTS ──
TTS_API_KEY=

# ── ERPNext ──
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ── Lago Billing ──
LAGO_API_URL=http://localhost:3001
LAGO_API_KEY=
LAGO_SECRET_KEY_BASE=      # REQUIRED: generate with `openssl rand -hex 64`
LAGO_RSA_PRIVATE_KEY=
LAGO_ENCRYPTION_PRIMARY_KEY=          # REQUIRED: generate with `openssl rand -hex 16`
LAGO_ENCRYPTION_DETERMINISTIC_KEY=    # REQUIRED: generate with `openssl rand -hex 16`
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=  # REQUIRED: generate with `openssl rand -hex 16`

# ── Supabase (Atomic CRM) ──
SUPABASE_DB_USER=supabase_admin
SUPABASE_DB_PASSWORD=      # REQUIRED: generate with `openssl rand -hex 24`
CRM_DB_NAME=crm_db
SUPABASE_JWT_SECRET=       # REQUIRED: generate with `openssl rand -base64 48`
SUPABASE_ANON_KEY=         # REQUIRED: generate via supabase dashboard
SUPABASE_SERVICE_KEY=      # REQUIRED: generate via supabase dashboard
SUPABASE_REALTIME_SECRET=  # REQUIRED: generate with `openssl rand -hex 32`

# ── Authentication ──
BETTER_AUTH_SECRET=        # REQUIRED: generate with `openssl rand -hex 32`
ADMIN_PASSWORD=            # REQUIRED: set a strong admin password

# ── Cal.com ──
CALCOM_NEXTAUTH_SECRET=    # REQUIRED: generate with `openssl rand -hex 32`
CALCOM_ENCRYPTION_KEY=     # REQUIRED: must be exactly 32 characters

# ── InvoiceShelf ──
INVOICESHELF_APP_KEY=      # REQUIRED: generate with `php artisan key:generate --show` or `openssl rand -base64 32`

# ── Business Defaults ──
BUSINESS_NAME=Mi Negocio
BUSINESS_CURRENCY=PEN
YAPE_NUMBER=938438401
YAPE_NAME=Juan Perez
PAYMENT_METHODS=yape,plin,bank_transfer
ESCALATION_THRESHOLD=500
BUSINESS_HOURS=09:00-18:00
