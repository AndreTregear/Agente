{
  "name": "@yaya/wa-voice",
  "version": "0.1.0",
  "description": "WhatsApp Web voice call handler — live AI voice conversations via Playwright + WebRTC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
