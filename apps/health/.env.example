# ═══════════════════════════════════════════════════════════════
# Yaya Salud — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Application ──────────────────────────────────────────────
# Port the app listens on (mapped from container)
APP_PORT=3000
NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=yaya_health
POSTGRES_USER=yaya
POSTGRES_PASSWORD=yaya_health_secret
# POSTGRES_PORT=5432                    # Host port (default: 5432)

# ── Redis ────────────────────────────────────────────────────
# REDIS_PORT=6379                       # Host port (default: 6379)

# ── AI / LLM (external GPU host) ────────────────────────────
# Points to vLLM on c.yaya.sh or any OpenAI-compatible endpoint
AI_API_KEY=
AI_BASE_URL=https://ai.yaya.sh/v1
AI_MODEL=qwen3.5-27b
AI_MAX_TOKENS=1024

# ── Speech-to-Text (external GPU host) ──────────────────────
# Whisper server for voice note transcription
# WHISPER_BASE_URL=http://c.yaya.sh:9300

# ── Authentication ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme-generate-a-real-secret
BETTER_AUTH_URL=http://localhost:3000

# ── Object Storage (MinIO) ──────────────────────────────────
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000    # Public-facing URL for file access
# MINIO_API_PORT=9000                    # Host port for S3 API
# MINIO_CONSOLE_PORT=9001               # Host port for MinIO web console

# ── OpenClaw Integration ────────────────────────────────────
# Path to openclaw binary (if running inside OpenClaw)
# OPENCLAW_BIN=/usr/local/bin/openclaw
OPENCLAW_AGENT=yaya-health
