# ═══════════════════════════════════════════════════════════════
# Yaya Platform — Environment Variables
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
APP_NAME=yaya

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://yaya:CHANGE_ME@localhost:5432/yaya

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI / LLM (vLLM) ──────────────────────────────────────────
VLLM_URL=http://localhost:8000/v1
VLLM_API_KEY=                          # Required — do NOT hardcode
VLLM_MODEL=qwen3.5-35b-a3b            # Default local model (MoE, 3B active)

# ── HPC GPU Cluster (optional) ────────────────────────────────
HPC_GPU1_URL=http://localhost:18080/v1
HPC_GPU2_URL=http://localhost:18081/v1
HPC_GPU3_URL=http://localhost:18082/v1
HPC_GPU4_URL=http://localhost:18083/v1
HPC_API_KEY=                           # Required if using HPC

# ── OpenClaw Agent ────────────────────────────────────────────
OPENCLAW_API_URL=http://localhost:3100/api/v1
OPENCLAW_API_KEY=
OPENCLAW_BIN=openclaw
OPENCLAW_AGENT=yaya
OPENCLAW_TIMEOUT_MS=120000
PRIVILEGED_JIDS=                       # Comma-separated WhatsApp JIDs

# ── Speech-to-Text (Whisper) ─────────────────────────────────
WHISPER_BASE_URL=http://localhost:9300/v1
WHISPER_API_KEY=
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=es

# ── ASR Provider Selection ────────────────────────────────────
ASR_PROVIDER=whisper                   # whisper | qwen3
QWEN_ASR_BASE_URL=
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=

# ── Text-to-Speech (Kokoro) ──────────────────────────────────
TTS_BASE_URL=http://localhost:9400
TTS_API_KEY=
TTS_DEFAULT_VOICE=af_heart

# ── TTS Provider Selection ────────────────────────────────────
TTS_PROVIDER=kokoro                    # kokoro | qwen3
QWEN_TTS_BASE_URL=
QWEN_TTS_API_KEY=
QWEN_TTS_VOICE=
QWEN_TTS_MODEL=

# ── Queue Settings ────────────────────────────────────────────
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
RATE_LIMIT=30
RATE_WINDOW_SEC=60
AI_CONCURRENCY=5

# ── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEK_PASSWORD=               # Required for field-level encryption
# Salt is auto-generated per deployment

# ── Service Ports ─────────────────────────────────────────────
PORT_BUSINESS=3000
PORT_HEALTH=3100
PORT_WEB=3005
PORT_CALCOM=3002
PORT_METABASE=3003
PORT_LAGO=3010
PORT_AUTHENTIK=9090
PORT_MINIO=9001

# ── Auth ──────────────────────────────────────────────────────
AUTH_URL=http://localhost:3001         # Better Auth (separate from business!)
AUTH_SECRET=                           # Session signing secret

# ── Object Storage (MinIO) ────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9001
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=yaya

# ── Admin (auto-created on first startup) ────────────────────
ADMIN_EMAIL=admin@agente.ceo
ADMIN_PASSWORD=                        # CHANGE_ME
ADMIN_NAME=Admin

# ── Business Defaults ────────────────────────────────────────
BUSINESS_NAME=Mi Negocio
BUSINESS_CURRENCY=PEN
YAPE_NUMBER=
YAPE_NAME=

# ── Legacy AI Config (used by autobot if VLLM_* not set) ─────
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=
AI_MODEL=qwen3.5-35b-a3b
AI_MAX_TOKENS=1024

# ── Auth (Better Auth) ──────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=                     # Session signing secret

# ── Database (Docker) ────────────────────────────────────────
POSTGRES_USER=yaya
POSTGRES_PASSWORD=                     # CHANGE_ME
POSTGRES_DB=yaya

# ── Object Storage (MinIO credentials) ──────────────────────
MINIO_ROOT_USER=yaya
MINIO_ROOT_PASSWORD=                   # CHANGE_ME
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── OSS Integrations ────────────────────────────────────────
CALCOM_API_URL=http://localhost:3002
CALCOM_API_KEY=
LAGO_API_URL=http://localhost:3010
LAGO_API_KEY=
METABASE_API_URL=http://localhost:3003
METABASE_API_KEY=
INVOICESHELF_API_URL=
INVOICESHELF_API_KEY=

# ── External Integrations ────────────────────────────────────
GOOGLE_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
